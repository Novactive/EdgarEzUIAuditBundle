{% extends '@ibexadesign/ui/layout.html.twig' %}

{% trans_default_domain 'edgarezuiaudit' %}
{% form_theme form_filter_audit '@ibexadesign/ui/form_fields.html.twig' %}
{% block breadcrumbs %}
    {% include '@ibexadesign/ui/breadcrumbs.html.twig' with { items: [
        { value: 'breadcrumb.audit'|trans(domain='messages')|desc('Audit') , },
        { url: path('edgar.audit.dashboard'), value: 'dashboard.breadcrumb.view'|trans|desc('Dashboard') },
    ]} %}
{% endblock %}
{% block header %}
    {% include '@ibexadesign/ui/page_title.html.twig' with {
        title: 'dashboard.view.title'|trans|desc('Audit dashboard'),
        iconName: 'dashboard'
    } %}
{% endblock %}

{% block content %}
    <section class="container ibexa-container">
        {% set body_rows = [] %}
        {{ form_start(form_filter_audit, {
            action: path('edgar.audit.dashboard'),
            attr: { class: 'edgar-audit-form' }
        }) }}
        <div class="input-group mb-3">
            <div class="select-types">
                {{ form_widget(form_filter_audit.audit_types) }}
            </div>
            <span class="input-group-btn search">
                <button type="submit" class="btn btn-primary">
                <svg class="ibexa-icon ibexa-icon--small">
                    <use xlink:href="{{ asset('bundles/ibexaicons/img/all-icons.svg') }}#search"></use>
                </svg>
                {{ 'dashboard.perform'|trans|desc('Search') }}</button>
            </span>
        </div>
        {% set date_start_label %}
            {{ form_label(form_filter_audit.date_start) }}
        {% endset %}

        {% set date_start %}
            <div class="flatpickr">
                {{ form_widget(form_filter_audit.date_start) }}
            </div>
        {% endset %}

        {% set date_end_label %}
            {{ form_label(form_filter_audit.date_end) }}
        {% endset %}

        {% set date_end %}
            <div class="flatpickr">
                {{ form_widget(form_filter_audit.date_end) }}
            </div>
        {% endset %}

        {% set body_rows = body_rows|merge([{ cols: [
            { content: date_start },
            { content: date_end },
        ] },
        ]) %}
        {% include '@ibexadesign/ui/component/table/table.html.twig' with {
            class: 'edgar-table-dash',
            headline:  'Additional filters'|trans ,
            body_rows,
            head_cols: [
                { content: date_start_label  },
                { content: date_end_label },
            ],
        } %}
        {{ form_end(form_filter_audit) }}
        <div>
            {% if results is defined %}
                {{ form_start(form_export_audit, { 'action': path('edgar.audit.export.ask') }) }}
                {{ form_row(form_export_audit.audit_types) }}
                {{ form_row(form_export_audit.date_start, { hidden: 'hidden' }) }}
                {{ form_row(form_export_audit.date_end, { hidden: 'hidden' }) }}
                {% set body_rows = [] %}


                {% for row in results %}
                    {% set user_id %}
                        {{ row.user_id }}
                    {% endset %}

                    {% set user_name %}
                        {{ row.user_name }}
                    {% endset %}

                    {% set group_name %}
                        {{ row.group_name }}
                    {% endset %}

                    {% set audit_name %}
                        {{ row.audit_name }}
                    {% endset %}

                    {% set infos %}
                        <ul>
                            {% for key, value in row.infos %}
                                <li>{{ key }}: {{ value }}</li>
                            {% endfor %}
                        </ul>
                    {% endset %}
                    {% set date %}
                        {{ row.date|date('M d, Y') }}
                    {% endset %}
                    {% set body_rows = body_rows|merge([{ cols: [
                        { content: user_id, raw: true },
                        { content: user_name, raw: true },
                        { content: group_name, raw: true },
                        { content: audit_name, raw: true },
                        { content: infos, raw: true },
                        { content: date, raw: true },
                    ] }]) %}
                {% endfor %}
                {% set actions %}
                    <span class="input-group-btn">
                        <button type="submit" class="btn btn-primary">
                        {{ 'export.perform'|trans|desc('Ask for an export') }}</button>
                    </span>
                {% endset %}
                {% include '@ibexadesign/ui/component/table/table.html.twig' with {
                    headline:  'search.header'|trans({'%total%': pager.nbResults})|desc('Search results (%total%)')  ,
                    head_cols: [
                        { content: 'log.user_id'|trans|desc('User ID')  },
                        { content: 'log.user_name'|trans|desc('User name') },
                        { content: 'log.group_name'|trans|desc('Group name') },
                        { content: 'log.audit_name'|trans|desc('Audit name') },
                        { content: 'log.infos'|trans|desc('Infos') },
                        { content: 'log.date'|trans|desc('Date') },
                    ],
                    body_rows,
                    actions:actions,
                    empty_table_info_text: 'search.no_result'|trans|desc('Sorry, no results were found.'),
                } %}
                {% if pager.haveToPaginate %}#}
                    <div class="row justify-content-center align-items-center">
                        {{ pagerfanta(pager, 'ibexa') }}
                    </div>
                {% endif %}
                {{ form_end(form_export_audit) }}
            {% endif %}
        </div>
    </section>
{% endblock %}

